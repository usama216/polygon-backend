PORT=4000
# Comma-separated for multiple origins (local + Vercel frontend)
FRONTEND_URL=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (dashboard)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-password
JWT_SECRET=change-me-to-a-long-random-string

# Optional: API key for curl/scripts (alternative to login token)
ADMIN_API_KEY=change-me-to-a-strong-secret

# Contact form — emails sent to this inbox
CONTACT_EMAIL=contact@polygonparadise.com

# SMTP (Gmail: smtp.gmail.com + App Password; or your domain host SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional "from" address (defaults to SMTP_USER)
SMTP_FROM=contact@polygonparadise.com
